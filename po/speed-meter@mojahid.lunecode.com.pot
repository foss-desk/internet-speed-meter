#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:9
msgid "Refresh interval in milliseconds"
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:10
msgid ""
"How frequently the network speed is polled from /proc/net/dev. Lower values "
"give more responsive readings but consume more CPU. Recommended range: 1000–"
"3000."
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:19
msgid "Display speed in bits per second"
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:20
msgid ""
"When true, speeds are shown in Kbps/Mbps (bits). When false, speeds are "
"shown in KB/s/MB/s (bytes). Default is bytes (false)."
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:29
msgid "Show upload speed"
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:30
msgid "Whether to display the upload (TX) speed in the panel."
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:35
msgid "Show download speed"
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:36
msgid "Whether to display the download (RX) speed in the panel."
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:41
msgid "Monitored Network Interface"
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:42
msgid ""
"Specific interface name (e.g. wlan0, eth0, tun0) or empty to sum all "
"hardware interfaces. Tunnels, bridges and container interfaces are left out "
"because their traffic already passes through a hardware interface."
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:48
msgid "Monthly Data Quota in GB"
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:49
msgid ""
"Monthly data usage limit in Gigabytes. Set to 0 to disable data quota "
"warnings."
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:54
msgid "Last quota notification"
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:55
msgid ""
"Month and level of the last quota notification, as \"YYYY-MM:80\" or \"YYYY-"
"MM:100\". Keeps each level to one notification per month across screen locks "
"and restarts."
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:60
msgid "Enable Data Quota Desktop Notifications"
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:61
msgid ""
"Whether to trigger system desktop notifications when reaching 80% and 100% "
"data quota."
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:66
msgid "Auto-hide panel when network is idle"
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:67
msgid ""
"Whether to hide the indicator from top panel when overall network speed is "
"below threshold."
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:73
msgid "Idle threshold in KB/s"
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:74
msgid ""
"Speed threshold in KB/s below which the indicator is hidden when auto-hide "
"is enabled."
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:79
msgid "Adaptive Power and Data Saver"
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:80
msgid ""
"Automatically increases the polling interval while running on battery power."
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:85
msgid "Track traffic per focused application"
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:86
msgid ""
"Show the focused application in the menu and attribute traffic to whichever "
"application is focused. This is an approximation, not per-process accounting."
msgstr ""
